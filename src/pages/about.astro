---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import PageHeader from '@sections/content/PageHeader.astro';
import ContentSection from '@sections/content/ContentSection.astro';
import CTA from '@sections/marketing/CTA.astro';
import { siteConfig } from '@/config';
---

<MarketingLayout
  title={`Σχετικά - ${siteConfig.name}`}
  description="Σχετικά με την ομάδα και τον σκοπό του Φωτοβολταϊκά Μπαλκονιού."
>
  <PageHeader title="Σχετικά με εμάς" align="left" maxWidth="lg">
    <p class="mt-6 text-lg text-text-muted leading-relaxed">
      Είμαστε μια μικρή ομάδα μηχανικών που πιστεύει ότι τα φωτοβολταϊκά μπαλκονιού μπορούν να
      αλλάξουν τον τρόπο που τα ελληνικά νοικοκυριά παράγουν ενέργεια. Εμπνευστήκαμε από τη διάδοση
      των plug-in PV στη Γερμανία και την Αυστρία και θέλουμε να κάνουμε εφικτό το ίδιο και στην
      Ελλάδα.
    </p>
    <p class="mt-4 text-lg text-text-muted leading-relaxed">
      Είμαστε η ίδια ομάδα που τρέχει το <a
        href="https://balconysolar.gr"
        class="text-primary hover:underline">balconysolar.gr</a
      >: ένα e-shop και έναν δωρεάν υπολογιστή παραγωγής. Αυτό το site είναι το <strong
        >ενημερωτικό</strong
      > σκέλος της αποστολής μας — δεν πουλάμε τίποτα εδώ.
    </p>
  </PageHeader>

  <ContentSection
    title="Τι κάνουμε εδώ"
    content={[
      'Δημοσιεύουμε ένα <strong>wiki</strong> με όλη τη γνώση που χρειάζεται κανείς για να καταλάβει τι είναι ένα plug-in φωτοβολταϊκό μπαλκονιού, πώς λειτουργεί, τι λέει η νομοθεσία, πώς εγκαθίσταται και τι αποδίδει.',
      'Διατηρούμε ένα <strong>blog</strong> με τα τελευταία νέα: ενημερώσεις του ΥΠΕΝ, αποφάσεις της ΡΑΑΕΥ, διαδικασίες του ΔΕΔΔΗΕ, ευρωπαϊκές οδηγίες, εξελίξεις στην αγορά. Στόχος είναι να μάθετε για κάθε σημαντική εξέλιξη μέσα σε 24 ώρες από τη δημοσίευσή της.',
      "Όλα είναι <strong>στα ελληνικά</strong>, ελεύθερα προσβάσιμα, χωρίς εγγραφή ή newsletter. Χρηματοδοτούμε τη συντήρηση από το αδελφικό balconysolar.gr — γι' αυτό προτείνουμε τον υπολογιστή του και το (μελλοντικό) e-shop όπου ταιριάζει.",
    ]}
    background="muted"
  />

  <CTA
    title="Έτοιμοι να μάθετε περισσότερα;"
    description="Ξεκινήστε από τα βασικά του Wiki ή δείτε τα τελευταία νέα στο blog."
    action={{ label: 'Διαβάστε το Wiki', href: '/wiki' }}
    secondaryAction={{ label: 'Δείτε το Blog', href: '/blog' }}
    background="default"
  />
</MarketingLayout>
