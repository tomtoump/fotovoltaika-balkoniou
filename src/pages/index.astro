---
import { getCollection, type CollectionEntry } from 'astro:content';
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Hero from '@sections/marketing/Hero.astro';
import HowItWorks from '@sections/marketing/HowItWorks.astro';
import CalculatorCTA from '@components/CalculatorCTA.astro';
import { Icon } from 'astro-icon/components';
import { siteConfig } from '@/config';

type BlogPost = CollectionEntry<'blog'>;

const allPosts = await getCollection('blog', ({ data }: { data: BlogPost['data'] }) => !data.draft);
const latestPosts = [...allPosts]
  .sort(
    (a: BlogPost, b: BlogPost) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime()
  )
  .slice(0, 3);
---

<MarketingLayout
  title={siteConfig.description}
  description={siteConfig.description}
>
  <Hero
    title={['Ο πλήρης οδηγός για τα φωτοβολταϊκά μπαλκονιού']}
    subtitle="Μάθε πώς μπορείς να παράγεις ρεύμα από το μπαλκόνι σου με ένα plug-and-play σύστημα. Με μια απλή πρίζα, χωρίς ταράτσα και χωρίς μεγάλη επένδυση."
    background="muted"
  />

  <HowItWorks
    title="Ό,τι χρειάζεστε για να αποφασίσετε"
    subtitle="Κατανοήστε τη λειτουργία, δείτε τις εξελίξεις και υπολογίστε αν σας συμφέρει."
    steps={[
      {
        title: 'Μάθε',
        description:
          'Οδηγός για τη λειτουργία, τη νομοθεσία, τον εξοπλισμό και την εγκατάσταση.',
        icon: 'lucide:book-open',
        href: '/wiki',
      },
      {
        title: 'Ενημερώσου',
        description:
          'Νέα για το θεσμικό πλαίσιο και την αγορά των φωτοβολταϊκών μπαλκονιού.',
        icon: 'lucide:newspaper',
        href: '/news',
      },
      {
        title: 'Υπολόγισε',
        description: 'Πάρε εκτίμηση παραγωγής, εξοικονόμησης και απόσβεσης για το δικό σου μπαλκόνι.',
        icon: 'lucide:calculator',
        href: siteConfig.calculatorUrl,
      },
    ]}
    variant="horizontal"
    background="default"
  />

  <!-- Latest blog posts -->
  <section class="py-section bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-text">Πρόσφατα άρθρα</h2>
        <p class="mt-4 text-lg text-text-muted">
          Τα τελευταία νέα για τα φωτοβολταϊκά μπαλκονιού στην Ελλάδα.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          latestPosts.map((post) => (
            <a href={`/news/${post.id}`} class="group block">
              <article class="h-full p-6 rounded-lg border border-border bg-background hover:border-primary hover:shadow-md transition-all">
                <div class="text-sm text-text-muted mb-2">
                  {post.data.publishedDate.toLocaleDateString('el-GR', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </div>
                <h3 class="text-lg font-semibold text-text group-hover:text-primary transition-colors line-clamp-2">
                  {post.data.title}
                </h3>
                <p class="mt-2 text-sm text-text-muted line-clamp-3">{post.data.description}</p>
              </article>
            </a>
          ))
        }
      </div>
      {
        latestPosts.length > 0 && (
          <div class="mt-10 text-center">
            <a
              href="/news"
              class="inline-flex items-center gap-2 text-primary font-medium hover:underline"
            >
              Όλα τα νέα
              <Icon name="lucide:arrow-right" class="w-4 h-4" />
            </a>
          </div>
        )
      }
    </div>
  </section>

  <CalculatorCTA />
</MarketingLayout>
