# =============================================================================
# Φωτοβολταϊκά Μπαλκονιού - Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# Canonical URL of the site (used for SEO, sitemaps, RSS feeds)
SITE_URL=https://fotovoltaika-balkoniou.gr

# Site name (header, footer, meta tags)
SITE_NAME=Φωτοβολταϊκά Μπαλκονιού

# Site description (SEO + meta)
SITE_DESCRIPTION=Ο οδηγός για φωτοβολταϊκά μπαλκονιού στην Ελλάδα: νομικό πλαίσιο, εγκατάσταση, απόδοση, κόστος.

# Author (meta tags + copyright)
SITE_AUTHOR=Φωτοβολταϊκά Μπαλκονιού

# Calculator URL on the sister site balconysolar.gr
CALCULATOR_URL=https://balconysolar.gr/#calc

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Leave blank to disable analytics in this environment.
# Note: PUBLIC_ prefix exposes the variable to the client bundle.
PUBLIC_GA_ID=
